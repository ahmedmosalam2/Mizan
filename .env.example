# ══════════════════════════════════════════════════════════════
# Mizan — Environment Variables
# ══════════════════════════════════════════════════════════════

# --- LLM Provider (Required) ---
GROQ_API_KEY=gsk_your_key_here

# --- LLM Gateway Middleware (Optional but highly recommended to bypass rate limits) ---
# Set this to route all framework adapter LLM queries through the local gateway
# LLM_GATEWAY_URL=http://localhost:8000/api/v1/llm

# --- Optional: Google Gemini ---
GOOGLE_API_KEY=

# --- Optional: OpenAI ---
OPENAI_API_KEY=

# --- Low-Code Platform URLs (only if benchmarking low-code) ---
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_ORCHESTRATION_FLOW=campaign-planning
LANGFLOW_TOOLS_FLOW=content-generation
LANGFLOW_SAFETY_FLOW=pii-scan
LANGFLOW_APPROVAL_FLOW=budget-approval
LANGFLOW_MEMORY_FLOW=customer-memory
LANGFLOW_DEPLOY_FLOW=channel-deploy
LANGFLOW_MULTIMODAL_FLOW=ad-generation

FLOWISE_BASE_URL=http://localhost:3000
FLOWISE_API_KEY=
FLOWISE_ORCHESTRATION_ID=orchestration
FLOWISE_TOOLS_ID=tools
FLOWISE_SAFETY_ID=safety
FLOWISE_APPROVAL_ID=approval
FLOWISE_MEMORY_ID=memory
FLOWISE_DEPLOY_ID=deploy
FLOWISE_MULTIMODAL_ID=multimodal

N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=
