# Mizan Benchmark — Environment Configuration
# Copy to .env and fill in your values

# ── LLM Backend ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o                  # Model used by all adapters during benchmark
OPENAI_BASE_URL=                     # Leave blank to use OpenAI default

# ── Benchmark settings ──────────────────────────────────────────────────
MIZAN_SEED=42                        # RNG seed for reproducibility
MIZAN_PROBE_TIMEOUT=180              # Default per-probe timeout in seconds
MIZAN_LLM_JUDGE=true                 # Use LLM-as-judge for content quality scoring
MIZAN_RESULTS_DIR=results            # Directory to store JSON run results
MIZAN_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ── Optional: Alternative LLM backends ─────────────────────────────────
ANTHROPIC_API_KEY=                   # For claude-3-5-sonnet / claude-opus-4
GOOGLE_API_KEY=                      # For gemini-2.0-flash
AZURE_OPENAI_ENDPOINT=               # For Azure OpenAI deployments
AZURE_OPENAI_API_KEY=

# ── Optional: Framework-specific overrides ──────────────────────────────
# Each framework can use a different model for its adapter
CREWAI_MODEL=
LANGGRAPH_MODEL=
AUTOGEN_MODEL=
AGNO_MODEL=
LLAMAINDEX_MODEL=
HAYSTACK_MODEL=
